# API Configuration (Copy to .env and fill with your actual keys)
# IMPORTANT: Never commit .env file with real keys!

# ══════════════════════════════════════════════════════
# US 주식 API (우선순위순)
# ══════════════════════════════════════════════════════

# Finnhub (US 1순위 - 무료 60회/분)
# 발급: https://finnhub.io/register → 무료 API Key 즉시 발급
FINNHUB_API_KEY=your_finnhub_api_key_here

# FMP - Financial Modeling Prep (US 2순위 - 무료 250회/일)
# 발급: https://site.financialmodelingprep.com/developer
FMP_API_KEY=your_fmp_api_key_here

# Alpha Vantage (폐기 - 하루 25회 한도로 부적합)
# ALPHA_VANTAGE_API_KEY=deprecated

# ══════════════════════════════════════════════════════
# KR 주식 API (우선순위순)
# ══════════════════════════════════════════════════════

# KRX Open API (KR 1순위 - 무료 10,000회/일)
# 발급: https://www.data.go.kr → 회원가입 → "주식시세정보" 검색 → 활용신청
KRX_API_KEY=your_krx_api_key_here

# DART OpenAPI (KR 2순위 - 재무제표/펀더멘탈)
# 발급: https://opendart.fss.or.kr → 회원가입 → 인증키 신청
DART_API_KEY=your_dart_api_key_here

# 한국투자증권 (KR 폴백 - 사용자 키 필요)
# 발급: https://apiportal.koreainvestment.com
# 개발 debug 빌드는 잦은 토큰 발급 방지를 위해 기본 비활성화됩니다.
# 실기기에서 최신 한국 시세를 확인하려면 true로 켜세요.
KOR_INVESTMENT_APP_KEY=your_key_here
KOR_INVESTMENT_SECRET=your_secret_here
KOR_INVESTMENT_ACCOUNT=12345678
ENABLE_KOR_INVESTMENT_DEBUG=false

# ══════════════════════════════════════════════════════
# 광고 (배포 시 필수)
# ══════════════════════════════════════════════════════

# Google AdMob
# Debug 빌드는 실제 값이 있어도 Google 테스트 ID를 강제 사용합니다.
# Profile/Release 빌드는 아래 실제 값을 사용합니다.
# AndroidManifest의 App ID도 .env 또는 환경변수의 ADMOB_ANDROID_APP_ID에서 주입됩니다.
ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
ADMOB_IOS_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
ADMOB_ANDROID_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
ADMOB_IOS_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
ADMOB_ANDROID_INTERSTITIAL_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
ADMOB_IOS_INTERSTITIAL_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
